# ===================================================================
# Just You & Me 💗 — Configuration Environment Variables
# ===================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to public GitHub repositories!

# 1. Supabase Project Configuration (REQUIRED)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. GIF Search Integration (OPTIONAL)
# If left blank, the app will use its built-in romantic animated stickers collection!
# Get a free Tenor or Giphy API key from:
# - Tenor: https://developers.google.com/tenor/guides/quickstart
# - Giphy: https://developers.giphy.com/
VITE_TENOR_API_KEY=
VITE_GIPHY_API_KEY=

# 3. WebRTC TURN Server (OPTIONAL BUT RECOMMENDED FOR MOBILE-TO-MOBILE CALLS)
# WebRTC uses public Google STUN servers by default. However, when one or both
# partners are on mobile cellular data (symmetric NAT/carrier-grade NAT), a TURN
# relay is required for guaranteed audio/video connectivity.
# Free / cheap TURN providers: Metered.ca (50GB free/mo), Xirsys, or self-hosted coturn.
VITE_TURN_SERVER_URLS=turn:global.relay.metered.ca:80
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
